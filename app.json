{
  "expo": {
    "name": "TaskFlow",
    "slug": "taskflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "backgroundImage": "./assets/icon.png"
      },
      "package": "com.agrawalsapps.taskflow"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "5d21aa18-30bf-4506-9392-f035f53421e0"
      }
    }
  }
}
